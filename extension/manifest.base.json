{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "ERATA",
  "version": "0.3.0",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "author": "Alexio",
  "homepage_url": "https://github.com/chiuta/erata",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "ERATA",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab"],
  "commands": {
    "fix-all": { "suggested_key": { "default": "Alt+Shift+F" }, "description": "Corectează tot în câmpul activ / Fix all in the active field" },
    "toggle-site": { "suggested_key": { "default": "Alt+Shift+E" }, "description": "Activează/dezactivează pe acest site / Toggle on this site" }
  }
}
